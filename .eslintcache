ecatedRules":"53"},{"filePath":"97","messages":"98","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"99","messages":"100","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"101","messages":"102","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},"C:\\Users\\User\\my-app\\src\\index.js",[],["103","104"],"C:\\Users\\User\\my-app\\src\\components\\Root.js",["105"],"C:\\Users\\User\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\User\\my-app\\src\\api\\espnApi.js",["106"],"\r\nexport async function getGames(league) {\r\n    var apiPath = 'https://secure.espn.com/core/' + league + '/schedule?year=2020&xhr=1';\r\n    var response = await fetch(apiPath).then(e => e.json()).then(r => r.content.schedule);\r\n    var size = Object.keys(response).length\r\n\r\n    var games = [];\r\n    for (let index = 0; index < size; index++) {\r\n        games.push(...response[Object.keys(response)[index]].games);\r\n    }\r\n\r\n\r\n\r\n    return Promise.all(games.map(g => {\r\n        var gameOrMatch = league === 'soccer' ? 'match' : 'game';\r\n        var id = g.id\r\n        return fetch('https://secure.espn.com/core/' + league + '/' + gameOrMatch + '?gameid=' + id + '&xhr=1&v=' + Date.now()).then(e => e.json()).then(f => f.gamepackageJSON);\r\n    })).then(r => {\r\n        var dto = [];\r\n        r.map(g => {\r\n            if (((g.odds && g.odds.findIndex(e => e.details && e.overUnder) >= 0)) || (g.pickcenter && g.pickcenter.findIndex(e => e.details && e.overUnder) >= 0)) {\r\n                var game = {\r\n                    competitors: g.header.competitions[0].competitors,\r\n                    odds: league === 'soccer' ? g.odds[g.odds.findIndex(e => e.details && e.overUnder)] : g.pickcenter[g.pickcenter.findIndex(e => e.details && e.overUnder)],\r\n                    date: g.header.competitions[0].date,\r\n                    status: g.header.competitions[0].status,\r\n                    id: g.header.id,\r\n                    lastPlay: g.commentary ? g.commentary[g.commentary.length - 1]?.text : g.plays ? g.plays[g.plays.length - 1]?.text : '',\r\n                    boxScore: g.boxscore.teams\r\n                };\r\n                dto.push(game);\r\n            }\r\n\r\n        })\r\n\r\n        return dto\r\n    })\r\n}\r\n\r\n\r\n","C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",["107"],"import React from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { AppBar, Toolbar, Button, Typography, Badge } from \"@material-ui/core\";\r\nimport { connect } from \"react-redux\";\r\n\r\nimport { logout } from \"../redux/actions/userActions\";\r\n\r\nfunction NavBar({ user, logout, ...props }) {\r\n    return (\r\n        <AppBar position=\"static\" style={{ display: \"flex\", backgroundColor: '#78b13f' }}>\r\n            <Toolbar>\r\n                <Typography variant=\"h6\">LSPN</Typography>\r\n                <div style={{ marginLeft: \"auto\" }}>\r\n                    {user.isAuthUser ? (\r\n                        <div>\r\n                            <Badge>{getBalance(user)}</Badge>\r\n                            <Link to=\"/home\">\r\n                                <Button>Dashboard</Button>\r\n                            </Link>\r\n                            <Link to=\"/my-account\">\r\n                                <Button>My Account</Button>\r\n                            </Link>\r\n                            <Button onClick={logout}>\r\n                                Logout\r\n                            </Button>\r\n                        </div>\r\n                    ) : (\r\n                            <div>\r\n                                <Link to=\"/login\">\r\n                                    <Button>Login</Button>\r\n                                </Link>\r\n                                <Link to=\"/register\">\r\n                                    <Button>Register</Button>\r\n                                </Link>\r\n                            </div>\r\n                        )}\r\n                </div>\r\n            </Toolbar>\r\n        </AppBar>\r\n    );\r\n}\r\n\r\nfunction getBalance(user) {\r\n\r\n    if (user.user.wagers) {\r\n        var balance = 0;\r\n        user.user.wagers.map(w => {\r\n            if (w.outcome === 'win') {\r\n                balance += parseInt(w.amount)\r\n            }\r\n            else if (w.outcome === 'loss') {\r\n                balance -= parseInt(w.amount)\r\n            }\r\n        });\r\n        return '$' + balance;\r\n    }\r\n    else {\r\n        return '$0'\r\n    }\r\n}\r\n\r\n\r\nexport default connect(({ user }) => ({ user }), { logout })(\r\n    NavBar\r\n);","C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",[],"C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["108","109","110"],"import React, { useEffect, useState } from 'react';\r\nimport '../App.css';\r\nimport { loadGames } from \"../redux/actions/gameActions\";\r\nimport { placeWager, loadUpdatedWagers } from \"../redux/actions/userActions\"\r\nimport { connect } from \"react-redux\";\r\nimport Matchup from './Matchup'\r\nimport { Card, Spinner } from 'reactstrap';\r\nimport {\r\n    useParams\r\n} from \"react-router-dom\";\r\n\r\n\r\n\r\nfunction Games({ loadGames, loadUpdatedWagers, user, games }) {\r\n    var { sport, week } = useParams();\r\n\r\n    useEffect(() => {\r\n        loadGames(sport, week);\r\n        loadUpdatedWagers();\r\n\r\n        const interval = setInterval(() => {\r\n            loadGames(sport, week)\r\n        }, 5000)\r\n\r\n        return () => clearInterval(interval)\r\n\r\n    }, [loadGames, sport, week]);\r\n\r\n    console.log(user.isLoading);\r\n\r\n    return (\r\n        !user.isLoading ?\r\n            <div className=\"App\">\r\n                {games ? games.sort((a, b) => a.date > b.date ? 1 : -1)\r\n                    .map(\r\n                        (item, index) => {\r\n                            if (item.status.type.name !== 'STATUS_CANCELED'\r\n                                && item.status.type.name !== 'STATUS_POSTPONED'\r\n                            ) {\r\n                                return <Card key={index} style={{ margin: 20 }}><Matchup sport={sport} game={item} wagers={mapGamesToWagers(item, user.user.wagers)} /></Card>\r\n                            }\r\n                            else {\r\n                                return []\r\n                            }\r\n\r\n                        }\r\n                    ) : []}\r\n            </div>\r\n            : <div className=\"App\">\r\n                <Spinner style={{ marginTop: '30px' }} type=\"grow\" color=\"dark\" />\r\n            </div>\r\n\r\n    )\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadGames,\r\n    loadUpdatedWagers\r\n};\r\n\r\nfunction mapGamesToWagers(game, wagers) {\r\n    var newWagers = Object.assign({}, game);\r\n    if (wagers) {\r\n        newWagers = wagers.filter(e => e.game_id === game.id);\r\n        return newWagers;\r\n    }\r\n    else {\r\n        return wagers;\r\n    }\r\n}\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n\r\n        games: state.games,\r\n        user: state.user\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",[],{"ruleId":"111","replacedBy":"112"},{"ruleId":"113","replacedBy":"114"},{"ruleId":"115","severity":1,"message":"116","line":8,"column":8,"nodeType":"117","messageId":"118","endLine":8,"endColumn":17},{"ruleId":"119","severity":1,"message":"120","line":20,"column":17,"nodeType":"121","messageId":"122","endLine":20,"endColumn":19},{"ruleId":"119","severity":1,"message":"120","line":47,"column":32,"nodeType":"121","messageId":"122","endLine":47,"endColumn":34},{"ruleId":"115","severity":1,"message":"123","line":1,"column":28,"nodeType":"117","messageId":"118","endLine":1,"endColumn":36},{"ruleId":"115","severity":1,"message":"124","line":4,"column":10,"nodeType":"117","messageId":"118","endLine":4,"endColumn":20},{"ruleId":"125","severity":1,"message":"126","line":27,"column":8,"nodeType":"127","endLine":27,"endColumn":32,"suggestions":"128"},"no-native-reassign",["129"],"no-negated-in-lhs",["130"],"no-unused-vars","'AuthRoute' is defined but never used.","Identifier","unusedVar","array-callback-return","Array.prototype.map() expects a return value from arrow function.","ArrowFunctionExpression","expectedInside","'useState' is defined but never used.","'placeWager' is defined but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'loadUpdatedWagers'. Either include it or remove the dependency array. If 'loadUpdatedWagers' changes too often, find the parent component that defines it and wrap that definition in useCallback.","ArrayExpression",["131"],"no-global-assign","no-unsafe-negation",{"desc":"132","fix":"133"},"Update