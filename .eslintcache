\r\n        case types.ADD_WAGER_SUCCESS: {\r\n            draft.wagers.push(action.payload);\r\n            break;\r\n        }\r\n        case types.GET_WAGERS_SUCCESS: {\r\n            draft.wagers = action.payload;\r\n            break;\r\n        }\r\n    }\r\n}, INITIAL_STATE);","C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["100"],"C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",[],{"ruleId":"101","replacedBy":"102"},{"ruleId":"103","replacedBy":"104"},{"ruleId":"105","severity":1,"message":"106","line":9,"column":5,"nodeType":"107","messageId":"108","endLine":13,"endColumn":6},{"ruleId":"105","severity":1,"message":"106","line":22,"column":5,"nodeType":"107","messageId":"108","endLine":48,"endColumn":6},{"ruleId":"109","severity":1,"message":"110","line":26,"column":8,"nodeType":"111","endLine":26,"endColumn":10,"suggestions":"112"},"no-native-reassign",["113"],"no-negated-in-lhs",["114"],"default-case","Expected a default case.","SwitchStatement","missingDefaultCase","react-hooks/exhaustive-deps","React Hook useEffect has missing dependencies: 'loadGames', 'loadUpdatedWagers', 'sport', and 'week'. Either include them or remove the dependency array. If 'loadGames' changes too often, find the parent component that defines it and wrap that definition in useCallback.","ArrayExpression",["115"],"no-global-assign","no-unsafe-negation",{"desc":"116","fix":"117"},"Update the dependencies array to be: [loadGames, loadUpdatedWagers, sport, week]",{"range":"118","