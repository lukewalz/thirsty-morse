ePath":"97","messages":"98","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"50"},"C:\\Users\\User\\my-app\\src\\index.js",[],["99","100"],"C:\\Users\\User\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",["101"],"import * as types from \"../actions/actionTypes\";\r\nimport produce from \"immer\"\r\n\r\n\r\nconst INITIAL_STATE = []\r\n\r\n\r\nexport const games = produce((draft, action) => {\r\n    switch (action.type) {\r\n        case types.GET_GAMES_SUCCESS: {\r\n            return action.payload\r\n        }\r\n    }\r\n}, INITIAL_STATE);","C:\\Users\\User\\my-app\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\User\\my-app\\src\\api\\espnApi.js",[],"C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",["102"],"import * as types from '../actions/actionTypes';\r\nimport Cookies from 'universal-cookie';\r\nimport produce from \"immer\"\r\n\r\nconst cookies = new Cookies();\r\n\r\n\r\nfunction isAuth() {\r\n    var auth = cookies.get('userSession') && !!localStorage.getItem(\"user\");\r\n    return auth;\r\n}\r\nconst INITIAL_STATE = {\r\n    isAuthUser: isAuth(),\r\n    user: JSON.parse(localStorage.getItem(\"user\")) || {},\r\n    isLoading: false,\r\n    error: null,\r\n    wagers: []\r\n};\r\n\r\n\r\nexport const user = produce((draft, action) => {\r\n    switch (action.type) {\r\n        case types.LOGIN_SUCCESS: {\r\n            localStorage.setItem(\"user\", JSON.stringify(action.payload));\r\n            draft.user = action.payload;\r\n            draft.isAuthUser = isAuth();\r\n            break;\r\n        }\r\n        case types.ADD_USER_SUCCESS: {\r\n            localStorage.setItem(\"user\", JSON.stringify(action.payload));\r\n            draft.user = action.payload;\r\n            draft.isAuthUser = isAuth();\r\n            break;\r\n        }\r\n        case types.LOGOUT_SUCCESS: {\r\n            draft.user = {};\r\n            draft.isAuthUser = isAuth();\r\n            break\r\n        }\r\n        case types.ADD_WAGER_SUCCESS: {\r\n            draft.wagers.push(action.payload);\r\n            break;\r\n        }\r\n        case types.GET_WAGERS_SUCCESS: {\r\n            draft.wagers = action.payload;\r\n            break;\r\n        }\r\n    }\r\n}, INITIAL_STATE);","C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",["103"],"import { Container } from 'reactstrap'\r\nimport { connect } from \"react-redux\";\r\nimport Table from '@material-ui/core/Table';\r\nimport TableBody from '@material-ui/core/TableBody';\r\nimport TableCell from '@material-ui/core/TableCell';\r\nimport TableContainer from '@material-ui/core/TableContainer';\r\nimport TableHead from '@material-ui/core/TableHead';\r\nimport TableRow from '@material-ui/core/TableRow';\r\nimport Paper from '@material-ui/core/Paper';\r\nimport { loadUpdatedWagers } from \"../redux/actions/userActions\"\r\nimport { loadGames } from \"../redux/actions/gameActions\"\r\nimport React, { useEffect } from 'react';\r\n\r\n\r\n\r\nfunction MyAccount({ loadUpdatedWagers, user }) {\r\n\r\n    useEffect(() => {\r\n        loadUpdatedWagers()\r\n    }, []);\r\n\r\n    return (\r\n        <Container>\r\n            <h3>{user.username}</h3>\r\n            <TableContainer component={Paper}>\r\n                <Table aria-label=\"simple table\">\r\n                    <TableHead>\r\n                        <TableRow>\r\n                            <TableCell>Date Placed</TableCell>\r\n                            <TableCell align=\"right\">Sport</TableCell>\r\n                            <TableCell align=\"right\">Game</TableCell>\r\n                            <TableCell align=\"right\">Game Date</TableCell>\r\n                            <TableCell align=\"right\">Selection</TableCell>\r\n                            <TableCell align=\"right\">Type</TableCell>\r\n                            <TableCell align=\"right\">Amount</TableCell>\r\n                            <TableCell align=\"right\">Boost</TableCell>\r\n                            <TableCell align=\"right\">Status</TableCell>\r\n                            <TableCell align=\"right\">Outcome</TableCell>\r\n                            <TableCell align=\"right\">Result</TableCell>\r\n                        </TableRow>\r\n                    </TableHead>\r\n                    <TableBody>\r\n                        {user.wagers.length > 0 ? user.wagers.map((row) => (\r\n                            <TableRow key={row.wager_date}>\r\n                                <TableCell component=\"th\" scope=\"row\">\r\n                                    {formatDate(row.wager_date)}\r\n                                </TableCell>\r\n                                <TableCell align=\"right\">{row.sport.toUpperCase()}</TableCell>\r\n                                <TableCell align=\"right\">{row.matchup}</TableCell>\r\n                                <TableCell align=\"right\">\r\n                                    {formatDate(row.game_date)}\r\n                                </TableCell>\r\n                                <TableCell align=\"right\">{row.selection}</TableCell>\r\n                                <TableCell align=\"right\">{row.wager_type.toUpperCase()}</TableCell>\r\n                                <TableCell align=\"right\">{row.amount}</TableCell>\r\n                                <TableCell align=\"right\">{row.boost}</TableCell>\r\n                                <TableCell align=\"right\">{row.status.toUpperCase()}</TableCell>\r\n                                <TableCell style={row.outcome.toLowerCase() === 'win' ? { color: 'green' } : row.outcome.toLowerCase() === 'loss' ? { color: 'red' } : []} align=\"right\">{row.outcome.toUpperCase()}</TableCell>\r\n                                <TableCell align=\"right\">{row.result ? Math.round(row.result) : row.result}</TableCell>\r\n                            </TableRow>\r\n                        )) : []}\r\n                    </TableBody>\r\n                </Table>\r\n            </TableContainer>\r\n        </Container>\r\n    );\r\n}\r\n\r\n\r\nfunction formatDate(date) {\r\n    var d = new Date(date);\r\n    return d.toLocaleString();\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadUpdatedWagers,\r\n    loadGames\r\n};\r\n\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n        user: state.user,\r\n        games: state.games\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(MyAccount);","C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["104"],"import React, { useEffect } from 'react';\r\nimport '../App.css';\r\nimport { loadGames } from \"../redux/actions/gameActions\";\r\nimport { loadUpdatedWagers } from \"../redux/actions/userActions\"\r\nimport { connect } from \"react-redux\";\r\nimport { Card } from 'reactstrap';\r\nimport Matchup from './Matchup'\r\nimport {\r\n    useParams\r\n} from \"react-router-dom\";\r\n\r\n\r\nfunction Games({ loadGames, games, loadUpdatedWagers }) {\r\n    var { sport, week } = useParams();\r\n\r\n    useEffect(() => {\r\n        loadUpdatedWagers();\r\n\r\n        loadGames(sport, week);\r\n\r\n        console.log('------------------------------------------------------')\r\n\r\n        const interval = setInterval(() => {\r\n            loadGames(sport, week)\r\n        }, 60000)\r\n\r\n        return () => clearInterval(interval)\r\n\r\n    }, []);\r\n\r\n    return (\r\n        <div className=\"App\">\r\n            {games ?\r\n                games.map(\r\n                    (item, index) => {\r\n                        if (item.status.type.name !== 'STATUS_CANCELED'\r\n                            && item.status.type.name !== 'STATUS_POSTPONED'\r\n                        ) {\r\n                            return <Card key={item.id} style={{ margin: 20 }}><Matchup sport={sport} game={item} /></Card>\r\n                        }\r\n                        else {\r\n                            return []\r\n                        }\r\n\r\n                    }\r\n                ) : []}\r\n        </div>\r\n    )\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadGames,\r\n    loadUpdatedWagers\r\n};\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n        games: state.games,\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",[],{"ruleId":"105","replacedBy":"106"},{"ruleId":"107","replacedBy":"108"},{"ruleId":"109","severity":1,"message":"110","line":9,"column":5,"nodeType":"111","messageId":"112","endLine":13,"endColumn":6},{"ruleId":"109","severity":1,"message":"110","line":22,"column":5,"nodeType":"111","messageId":"112","endLine":48,"endColumn":6},{"ruleId":"113","severity":1,"message":"114","line":20,"column":8,"nodeType":"115","endLine":20,"endColumn":10,"suggestions":"116"},{"ruleId":"113","severity":1,"message":"117","line":29,"column":8,"nodeType":"115","endLine":29,"endColumn":10,"suggestions":"118"},"no-native-reassign",["119"],"no-negated-in-lhs",["120"],"default-case","Expected a default case.","SwitchStatement","missingDefaultCase","react-hooks/exhau