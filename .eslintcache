ndex.js",[],["65","66"],"C:\\Users\\User\\my-app\\src\\components\\Root.js",[],"C:\\Users\\User\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\Dashboard.js",[],"C:\\Users\\User\\my-app\\src\\Auth.js",["67"],"import React, { useState } from \"react\";\r\nimport { Button, Form, FormGroup, Label, Input, FormText, Container } from 'reactstrap';\r\nimport Login from './api/lspnApi';\r\n\r\nfunction Auth() {\r\n    const [username, setUsername] = useState('');\r\n    const [password, setPassword] = useState('');\r\n\r\n    return (\r\n        <Container style={{ display: \"flex\", justifyContent: 'center', alignContent: 'center', flexDirection: 'column', height: '100vh' }}>\r\n            <div className='form'>\r\n                <Form>\r\n                    <FormGroup>\r\n                        <Label for=\"exampleEmail\">Email</Label>\r\n                        <Input type=\"test\" name=\"email\" id=\"exampleEmail\" value={username} placeholder=\"username\" onChange={(text) => setUsername(text.target.value)} />\r\n                    </FormGroup>\r\n                    <FormGroup>\r\n                        <Label for=\"examplePassword\">Password</Label>\r\n                        <Input type=\"password\" name=\"password\" id=\"examplePassword\" value={password} placeholder=\"password\" onChange={(text) => setPassword(text.target.value)} />\r\n                    </FormGroup>\r\n                    <Button onClick={() => Login(username, password)}>Submit</Button>\r\n                </Form>\r\n            </div>\r\n\r\n        </Container>)\r\n}\r\n\r\nexport default Auth;\r\n\r\n\r\n","C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\Games.js",["68"],"import React, { useEffect, useState } from 'react';\r\nimport './App.css';\r\nimport { loadGames } from \"./redux/actions/gameActions\";\r\nimport { connect } from \"react-redux\";\r\nimport Matchup from './Matchup'\r\nimport { Container, Card, Button, Spinner } from 'reactstrap';\r\nimport {\r\n    useParams\r\n} from \"react-router-dom\";\r\n\r\n\r\nfunction Games({ loadGames, games }) {\r\n    var { sport, week } = useParams();\r\n\r\n    useEffect(() => {\r\n        loadGames(sport, week).then(() => setDoneLoading(true));\r\n    }, [loadGames]);\r\n\r\n    const [doneLoading, setDoneLoading] = useState(false);\r\n    const [myPicks, setMyPicks] = useState(false);\r\n\r\n\r\n    return (\r\n        doneLoading ?\r\n            <Container>\r\n                <Button onClick={() => setMyPicks(!myPicks)}>{myPicks ? 'Show All Matchups' : 'Show Only My Picks'}</Button>\r\n                {games?.map(\r\n                    (item, index) => {\r\n                        return <Card key={index} style={{ margin: 20 }}><Matchup game={item} myPicks={myPicks} /></Card>\r\n\r\n                    }\r\n                )}\r\n            </Container>\r\n            : <Container>      <Spinner type=\"grow\" color=\"dark\" />\r\n            </Container>\r\n\r\n    )\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadGames\r\n};\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n        games: state.games,\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",[],"C:\\Users\\User\\my-app\\src\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\User\\my-app\\src\\api\\espnApi.js",[],"C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],{"ruleId":"69","replacedBy":"70"},{"ruleId":"71","replacedBy":"72"},{"ruleId":"73","severity":1,"message":"74","line":2,"column":49,"nodeType":"75","messageId":"76","endLine":2,"endColumn":57},{"ruleId":"77","severity":1,"message":"78","line":17,"column":8,"nodeType":"79","endLine":17,"en