oot.js",[],"C:\\Users\\User\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\Dashboard.js",[],"C:\\Users\\User\\my-app\\src\\Auth.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\Games.js",["66"],"import React, { useEffect, useState } from 'react';\r\nimport './App.css';\r\nimport { loadGames } from \"./redux/actions/gameActions\";\r\nimport { connect } from \"react-redux\";\r\nimport Matchup from './Matchup'\r\nimport { Container, Card, Button, Spinner } from 'reactstrap';\r\nimport {\r\n    useParams\r\n} from \"react-router-dom\";\r\n\r\n\r\nfunction Games({ loadGames, games }) {\r\n    var { sport, week } = useParams();\r\n\r\n    useEffect(() => {\r\n        loadGames(sport, week).then(() => setDoneLoading(true));\r\n    }, [loadGames]);\r\n\r\n    const [doneLoading, setDoneLoading] = useState(false);\r\n    const [myPicks, setMyPicks] = useState(false);\r\n\r\n\r\n    return (\r\n        doneLoading ?\r\n            <Container>\r\n                <Button onClick={() => setMyPicks(!myPicks)}>{myPicks ? 'Show All Matchups' : 'Show Only My Picks'}</Button>\r\n                {games?.map(\r\n                    (item, index) => {\r\n                        return <Card key={index} style={{ margin: 20 }}><Matchup game={item} myPicks={myPicks} /></Card>\r\n\r\n                    }\r\n                )}\r\n            </Container>\r\n            : <Container>      <Spinner type=\"grow\" color=\"dark\" />\r\n            </Container>\r\n\r\n    )\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadGames\r\n};\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n        games: state.games,\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",[],"C:\\Users\\User\\my-app\\src\\Matchup.js",[