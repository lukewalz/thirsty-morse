(e => e.status === 'final').map(w => {\r\n                return balance += parseInt(w.result);\r\n            }) : setBalance(0);\r\n            setBalance(balance);\r\n        }\r\n\r\n    }, [user.wagers.length]);\r\n\r\n    const [balance, setBalance] = useState();\r\n\r\n    function isPushNotificationSupported() {\r\n        if ('serviceWorker' in navigator) {\r\n            window.addEventListener('load', () => {\r\n                navigator.serviceWorker.register('/sw.js')\r\n                    .then(reg => {\r\n\r\n                    })\r\n                    .catch(err => {\r\n\r\n                    })\r\n            })\r\n        }\r\n    }\r\n\r\n    async function askUserPermission() {\r\n        if (typeof Notification !== 'undefined') {\r\n            return await Notification.requestPermission();\r\n        }\r\n    }\r\n\r\n    isPushNotificationSupported();\r\n\r\n\r\n    return (\r\n        <AppBar position=\"static\" style={{ display: \"flex\", backgroundColor: '#78b13f' }}>\r\n            <Toolbar>\r\n                <Typography variant=\"h6\">LSPN</Typography>\r\n                <div style={{ marginLeft: \"auto\" }}>\r\n                    {user.isAuthUser ? (\r\n                        <div>\r\n                            <Badge>{balance}</Badge>\r\n                            <Link to=\"/home\">\r\n                                <Button>Dashboard</Button>\r\n                            </Link>\r\n                            <Link to=\"/my-account\">\r\n                                <Button>My Account</Button>\r\n                            </Link>\r\n                            <Button onClick={logout}>\r\n                                Logout\r\n                            </Button>\r\n                        </div>\r\n                    ) : (\r\n                            <div>\r\n                                <Link to=\"/login\">\r\n                                    <Button>Login</Button>\r\n                                </Link>\r\n                                <Link to=\"/register\">\r\n                                    <Button>Register</Button>\r\n                                </Link>\r\n                            </div>\r\n                        )}\r\n                </div>\r\n            </Toolbar>\r\n        </AppBar>\r\n    );\r\n}\r\n\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n        user: state.user\r\n    };\r\n}\r\n\r\nconst mapDispatchToProps = {\r\n    logout,\r\n    loadUpdatedWagers\r\n};\r\n\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(NavBar);\r\n","C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",[],"C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",[],"C:\\Users\\User\\my-app\\src\\subscriptions.js",[],{"ruleId":"103","replacedBy":"104"},{"ruleId":"105","replacedBy":"106"},{"ruleId":"107","severity":1,"message":"108","line":32,"column":8,"nodeType":"109","endLine":32,"endColumn":28,"suggestions":"110"},"no-native-reassign",["111"],"no-negated-in-lhs",["112"],"react-hooks/exhaustive-deps","React Hook useEffect has missing dependencies: 'loadUpdatedWagers', 'user.isAuthUser', and 'user.wagers'. Either include them or remove the dependency array. If 'loadUpdatedWagers' changes too often, find the parent component that defines it and wrap that definition in useCallback.","ArrayExpression",["113"],"no-global-assign","no-unsafe-negation",{"desc":"114","fix":"115"},"Upda