     user.wagers && user.wagers.length > 0 ? user.wagers.filter(e => e.status === 'final').map(w => {\r\n                return balance += parseInt(w.result);\r\n            }) : setBalance(0);\r\n            setBalance(balance);\r\n        }\r\n\r\n    }, [user.wagers.length]);\r\n\r\n    const [balance, setBalance] = useState();\r\n\r\n    function isPushNotificationSupported() {\r\n        if ('serviceWorker' in navigator) {\r\n            window.addEventListener('load', () => {\r\n                navigator.serviceWorker.register('/sw.js')\r\n                    .then(reg => {\r\n\r\n                    })\r\n                    .catch(err => {\r\n\r\n                    })\r\n            })\r\n        }\r\n    }\r\n\r\n    async function askUserPermission() {\r\n        if (typeof Notification !== 'undefined') {\r\n            return await Notification.requestPermission();\r\n        }\r\n    }\r\n\r\n    isPushNotificationSupported();\r\n\r\n\r\n    return (\r\n        <AppBar position='sticky'>\r\n            <Toolbar>\r\n                <Typography variant=\"h6\">TMSB</Typography>\r\n                <div style={{ marginLeft: \"auto\" }}>\r\n                    {user.isAuthUser ? (\r\n                        <Box flexDirection='column'>\r\n\r\n                            <Link to=\"/home\">\r\n                                <Button>Dashboard</Button>\r\n                            </Link>\r\n                            <Link to=\"/my-account\">\r\n                                <Button>Account</Button>\r\n                            </Link>\r\n                            <Button onClick={logout}>\r\n                                Logout\r\n                            </Button>\r\n\r\n                        </Box>\r\n                    ) : (\r\n                        <Box>\r\n                            <Link to=\"/login\">\r\n                                <Button>Login</Button>\r\n                            </Link>\r\n                            <Link to=\"/register\">\r\n                                <Button>Register</Button>\r\n                            </Link>\r\n                        </Box>\r\n                    )}\r\n                </div>\r\n            </Toolbar>\r\n        </AppBar >\r\n    );\r\n}\r\n\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n        user: state.user\r\n    };\r\n}\r\n\r\nconst mapDispatchToProps = {\r\n    logout,\r\n    loadUpdatedWagers\r\n};\r\n\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(NavBar);\r\n","C:\\Users\\LukeWalz\\thirsty-morse\\src\\redux\\configureStore.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\components\\AuthRoute.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\pages\\HomePage.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\subscriptions.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\components\\Widget.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\pages\\Matchup.js",["107","108","109","110","111","112","113","114","115"],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\api\\espnApi.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\redux\\reducers\\index.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\api\\lspnApi.js",[],"C:\\Users\\LukeWalz\\thirsty-morse\\src\\components\\OverUnderWidget.js",["116"],"import React from 'react';\r\nimport { Chip, Paper } from '@material-ui/core';\r\n\r\nexport const OverUnderWidget = (props) => {\r\n    return (\r\n        <div style={{ display: 'flex', justifyContent: 'center', height: '100%' }}>\r\n\r\n            {props.wager ? props.wager.map((e, i) => e.wager_type === 'ou' ?\r\n                e.status === 'final' ?\r\n                    e.selection.split('@')[0] === 'o' ?\r\n                        <div key={i}><Chip style={{\r\n                            backgroundColor: '#8bc34a', borderRadius: \"50%\",\r\n               