hUser: false, user: {} };\r\n        default:\r\n            return state;\r\n    }\r\n};","C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],["106","107"],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["108"],"C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",["109","110","111","112"],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",["113"],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",["114","115"],"import React from 'react';\r\nimport { Card, Badge, Button } from 'reactstrap'\r\nimport ImportExportIcon from '@material-ui/icons/ImportExport';\r\nimport ArrowUpwardIcon from '@material-ui/icons/ArrowUpward';\r\nimport ArrowDownwardIcon from '@material-ui/icons/ArrowDownward';\r\n\r\nexport const OverUnderWidget = (props) => {\r\n    return (\r\n        <Card style={{ display: 'flex', justifyContent: 'center', height: '100%' }}>\r\n\r\n            {props.wager ? props.wager.map((e, i) => e.wager_type === 'ou' ?\r\n                e.selection === 'o' ?\r\n                    <div><Button style={{ backgroundColor: '#8bc34a' }} onClick={g => { g.stopPropagation(); props.handleWagerClick(e) }} key={i} >{e.amount}</Button><ArrowUpwardIcon /></div> :\r\n                    <div><Button style={{ backgroundColor: '#8bc34a' }} onClick={g => { g.stopPropagation(); props.handleWagerClick(e) }} key={i} >{e.amount}</Button><ArrowDownwardIcon /></div>\r\n                : []) : []}\r\n            <b style={{ fontSize: '20px' }}>{props.children}</b>\r\n        </Card>\r\n\r\n    )\r\n}",{"ruleId":"116","replacedBy":"117"},{"ruleId":"118","replacedBy":"119"},{"ruleId":"120","severity":1,"message":"121","line":8,"column":8,"nodeTy