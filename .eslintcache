les":"52"},{"filePath":"96","messages":"97","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"98","messages":"99","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"100","messages":"101","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},"C:\\Users\\User\\my-app\\src\\index.js",[],["102","103"],"C:\\Users\\User\\my-app\\src\\components\\Root.js",["104"],"C:\\Users\\User\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\User\\my-app\\src\\api\\espnApi.js",["105"],"C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",["106"],"import React from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { AppBar, Toolbar, Button, Typography, Badge } from \"@material-ui/core\";\r\nimport { connect } from \"react-redux\";\r\n\r\nimport { logout } from \"../redux/actions/userActions\";\r\n\r\nfunction NavBar({ user, logout, ...props }) {\r\n    return (\r\n        <AppBar position=\"static\" style={{ display: \"flex\", backgroundColor: '#78b13f' }}>\r\n            <Toolbar>\r\n                <Typography variant=\"h6\">LSPN</Typography>\r\n                <div style={{ marginLeft: \"auto\" }}>\r\n                    {user.isAuthUser ? (\r\n                        <div>\r\n                            <Badge>{getBalance(user)}</Badge>\r\n                            <Link to=\"/home\">\r\n                                <Button>Dashboard</Button>\r\n                            </Link>\r\n                            <Link to=\"/my-account\">\r\n                                <Button>My Account</Button>\r\n                            </Link>\r\n                            <Button onClick={logout}>\r\n                                Logout\r\n                </Button>\r\n                        </div>\r\n                    ) : (\r\n                            <div>\r\n                                <Link to=\"/login\">\r\n                                    <Button>Login</Button>\r\n                                </Link>\r\n                                <Link to=\"/register\">\r\n                                    <Button>Register</Button>\r\n                                </Link>\r\n                            </div>\r\n                        )}\r\n                </div>\r\n            </Toolbar>\r\n        </AppBar>\r\n    );\r\n}\r\n\r\nfunction getBalance(user) {\r\n\r\n    if (user.user.wagers) {\r\n        var balance = 0;\r\n        user.user.wagers.map(w => {\r\n            if (w.outcome === 'win') {\r\n                balance += parseInt(w.amount)\r\n            }\r\n            else if (w.outcome === 'loss') {\r\n                balance -= parseInt(w.amount)\r\n            }\r\n        });\r\n        return '$' + balance;\r\n    }\r\n    else {\r\n        return '$0'\r\n    }\r\n}\r\n\r\n\r\nexport default connect(({ user }) => ({ user }), { logout })(\r\n    NavBar\r\n);","C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",[],"C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",["107","108"],"import { Container } from 'reactstrap'\r\nimport { connect } from \"react-redux\";\r\nimport Table from '@material-ui/core/Table';\r\nimport TableBody from '@material-ui/core/TableBody';\r\nimport TableCell from '@material-ui/core/TableCell';\r\nimport TableContainer from '@material-ui/core/TableContainer';\r\nimport TableHead from '@material-ui/core/TableHead';\r\nimport TableRow from '@material-ui/core/TableRow';\r\nimport Paper from '@material-ui/core/Paper';\r\nimport { loadUpdatedWagers } from \"../redux/actions/userActions\"\r\nimport { loadGames } from \"../redux/actions/gameActions\"\r\nimport React, { useEffect, useState } from 'react';\r\n\r\n\r\n\r\nfunction MyAccount({ loadUpdatedWagers, loadGames, user }) {\r\n\r\n    useEffect(() => {\r\n        loadUpdatedWagers()\r\n    }, []);\r\n\r\n    return (\r\n        <Container>\r\n            <TableContainer component={Paper}>\r\n                <Table aria-label=\"simple table\">\r\n                    <TableHead>\r\n                        <TableRow>\r\n                            <TableCell>Date Placed</TableCell>\r\n                            <TableCell align=\"right\">Sport</TableCell>\r\n                            <TableCell align=\"right\">Game</TableCell>\r\n                            <TableCell align=\"right\">Game Date</TableCell>\r\n                            <TableCell align=\"right\">Selection</TableCell>\r\n                            <TableCell align=\"right\">Amount</TableCell>\r\n                            <TableCell align=\"right\">Result</TableCell>\r\n                        </TableRow>\r\n                    </TableHead>\r\n                    <TableBody>\r\n                        {user && user.wagers ? user.wagers.map((row) => (\r\n                            <TableRow key={row.wager_date}>\r\n                                <TableCell component=\"th\" scope=\"row\">\r\n                                    {formatDate(row.wager_date)}\r\n                                </TableCell>\r\n                                <TableCell align=\"right\">{row.sport.toUpperCase()}</TableCell>\r\n                                <TableCell align=\"right\">{row.matchup}</TableCell>\r\n                                <TableCell align=\"right\">\r\n                                    {formatDate(row.game_date)}\r\n                                </TableCell>\r\n                                <TableCell align=\"right\">{row.selection}</TableCell>\r\n                                <TableCell align=\"right\">{row.amount}</TableCell>\r\n                                <TableCell align=\"right\">{row.outcome.toUpperCase()}</TableCell>\r\n                            </TableRow>\r\n                        )) : []}\r\n                    </TableBody>\r\n                </Table>\r\n            </TableContainer>\r\n        </Container>\r\n    );\r\n}\r\n\r\n\r\nfunction formatDate(date) {\r\n    var d = new Date(date);\r\n    return d.toLocaleString();\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadUpdatedWagers,\r\n    loadGames\r\n};\r\n\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n        user: state.user.user,\r\n        games: state.games\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(MyAccount);","C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["109"],"import React, { useEffect, useState } from 'react';\r\nimport '../App.css';\r\nimport { loadGames } from \"../redux/actions/gameActions\";\r\nimport { placeWager, loadUpdatedWagers } from \"../redux/actions/userActions\"\r\nimport { connect } from \"react-redux\";\r\nimport Matchup from './Matchup'\r\nimport { Card, Spinner } from 'reactstrap';\r\nimport {\r\n    useParams\r\n} from \"react-router-dom\";\r\n\r\n\r\n\r\nfunction Games({ loadGames, placeWager, loadUpdatedWagers, user, games }) {\r\n    var { sport, week } = useParams();\r\n\r\n    useEffect(() => {\r\n        loadGames(sport, week);\r\n        loadUpdatedWagers().then(() => setDoneLoading(true))\r\n\r\n        const interval = setInterval(() => {\r\n            loadGames(sport, week)\r\n        }, 10000)\r\n\r\n        return () => clearInterval(interval)\r\n\r\n    }, [loadGames, sport, week]);\r\n\r\n    const [doneLoading, setDoneLoading] = useState(false);\r\n\r\n\r\n    return (\r\n        doneLoading ?\r\n            <div className=\"App\">\r\n                {games ? games.sort((a, b) => a.date > b.date ? 1 : -1)\r\n                    .map(\r\n                        (item, index) => {\r\n                            if (item.status.type.name !== 'STATUS_CANCELED'\r\n                                && item.status.type.name !== 'STATUS_POSTPONED'\r\n                            ) {\r\n                                return <Card key={index} style={{ margin: 20 }}><Matchup done={false} sport={sport} game={item} wagers={mapGamesToWagers(item, user.user.wagers)} placeWager={(e) => placeWager(e)} /></Card>\r\n                            }\r\n                            else {\r\n                                return []\r\n                            }\r\n\r\n                        }\r\n                    ) : []}\r\n            </div>\r\n            : <div className=\"App\">\r\n                <Spinner style={{ marginTop: '30px' }} type=\"grow\" color=\"dark\" />\r\n            </div>\r\n\r\n    )\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadGames,\r\n    placeWager,\r\n    loadUpdatedWagers\r\n};\r\n\r\nfunction mapGamesToWagers(game, wagers) {\r\n    var newWagers = Object.assign({}, game);\r\n    if (wagers) {\r\n        newWagers = wagers.filter(e => e.game_id === game.id);\r\n        return newWagers;\r\n    }\r\n    else {\r\n        return wagers;\r\n    }\r\n}\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n\r\n        games: state.games,\r\n        user: state.user\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",["110"],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUn