\r\n                id: g.header.id\r\n            };\r\n            dto.push(game);\r\n        })\r\n\r\n\r\n        return dto\r\n    })\r\n}\r\n\r\n\r\n","C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",[],"C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],["105","106"],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",[],{"ruleId":"107","replacedBy":"108"},{"ruleId":"109","replacedBy":"110"},{"ruleId":"111","severity":1,"message":"112","line":8,"column":8,"nodeType":"113","messageId":"114","endLine":8,"endColumn":17},{"ruleId":"115","severity":1,"message":"116","line":18,"column":17,"nodeType":"117","messageId":"118","endLine":18,"endColumn":19},{"ruleId":"107","replacedBy":"119"},{"ruleId":"109","replacedBy":"120"},"no-native-reassign",["121"],"no-negated-in-lhs",["122"],"no-unused-vars","'AuthRoute' is defined but never used.","Identifier","unusedVar","array-callback-return","Array.prototype.map() expects a return value from arrow function.","ArrowFunctionExpression","expectedInside",["121"],["122"],"no-global-assign","no-unsafe-negation"]