essages":"96","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"50"},"C:\\Users\\User\\my-app\\src\\index.js",[],["97","98"],"C:\\Users\\User\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\User\\my-app\\src\\api\\espnApi.js",["99"],"C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",["100"],"import React from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { AppBar, Toolbar, Button, Typography, Badge } from \"@material-ui/core\";\r\nimport { connect } from \"react-redux\";\r\n\r\nimport { logout } from \"../redux/actions/userActions\";\r\n\r\nfunction NavBar({ user, logout }) {\r\n    return (\r\n        <AppBar position=\"static\" style={{ display: \"flex\", backgroundColor: '#78b13f' }}>\r\n            <Toolbar>\r\n                <Typography variant=\"h6\">LSPN</Typography>\r\n                <div style={{ marginLeft: \"auto\" }}>\r\n                    {user.isAuthUser ? (\r\n                        <div>\r\n                            <Badge>{getBalance(user)}</Badge>\r\n                            <Link to=\"/home\">\r\n                                <Button>Dashboard</Button>\r\n                            </Link>\r\n                            <Link to=\"/my-account\">\r\n                                <Button>My Account</Button>\r\n                            </Link>\r\n                            <Button onClick={logout}>\r\n                                Logout\r\n                            </Button>\r\n                        </div>\r\n                    ) : (\r\n                            <div>\r\n                                <Link to=\"/login\">\r\n                                    <Button>Login</Button>\r\n                                </Link>\r\n                                <Link to=\"/register\">\r\n                                    <Button>Register</Button>\r\n                                </Link>\r\n                            </div>\r\n                        )}\r\n                </div>\r\n            </Toolbar>\r\n        </AppBar>\r\n    );\r\n}\r\n\r\nfunction getBalance(user) {\r\n\r\n    if (user.user.wagers) {\r\n        var balance = 0;\r\n        user.user.wagers.map(w => {\r\n            if (w.outcome === 'win') {\r\n                balance += parseInt(w.amount)\r\n            }\r\n            else if (w.outcome === 'loss') {\r\n                balance -= parseInt(w.amount)\r\n            }\r\n        });\r\n        return '$' + balance;\r\n    }\r\n    else {\r\n        return '$0'\r\n    }\r\n}\r\n\r\n\r\nexport default connect(({ user }) => ({ user }), { logout })(\r\n    NavBar\r\n);","C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",[],"C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["101","102"],"import React, { useEffect, useState } from 'react';\r\nimport '../App.css';\r\nimport { loadGames } from \"../redux/actions/gameActions\";\r\nimport { loadUpdatedWagers } from \"../redux/actions/userActions\"\r\nimport { connect } from \"react-redux\";\r\nimport Matchup from './Matchup'\r\nimport { Card, Spinner } from 'reactstrap';\r\nimport {\r\n    useParams\r\n} from \"react-router-dom\";\r\n\r\n\r\nfunction Games({ loadGames, loadUpdatedWagers, user, games }) {\r\n    var { sport, week } = useParams();\r\n\r\n    useEffect(() => {\r\n        loadGames(sport, week);\r\n        loadUpdatedWagers();\r\n\r\n        const interval = setInterval(() => {\r\n            loadGames(sport, week)\r\n        }, 5000)\r\n\r\n        return () => clearInterval(interval)\r\n\r\n    }, []);\r\n\r\n    return (\r\n        !user.isLoading ?\r\n            <div className=\"App\">\r\n                {games ? games.sort((a, b) => a.date > b.date ? 1 : -1)\r\n                    .map(\r\n                        (item, index) => {\r\n                            if (item.status.type.name !== 'STATUS_CANCELED'\r\n                                && item.status.type.name !== 'STATUS_POSTPONED'\r\n                            ) {\r\n                                return <Card key={index} style={{ margin: 20 }}><Matchup sport={sport} game={item} wagers={mapGamesToWagers(item, user.user.wagers)} /></Card>\r\n                            }\r\n                            else {\r\n                                return []\r\n                            }\r\n\r\n                        }\r\n                    ) : []}\r\n            </div>\r\n            : <div className=\"App\">\r\n                <Spinner style={{ marginTop: '30px' }} type=\"grow\" color=\"dark\" />\r\n            </div>\r\n\r\n    )\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadGames,\r\n    loadUpdatedWagers\r\n};\r\n\r\nfunction mapGamesToWagers(game, wagers) {\r\n    var newWagers = Object.assign({}, game);\r\n    if (wagers) {\r\n        newWagers = wagers.filter(e => e.game_id === game.id);\r\n        return newWagers;\r\n    }\r\n    else {\r\n        return wagers;\r\n    }\r\n}\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n\r\n        games: state.games,\r\n        user: state.user\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\