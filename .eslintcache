lePath":"95","messages":"96","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"97","messages":"98","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"99","messages":"100","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},"C:\\Users\\User\\my-app\\src\\index.js",[],["101","102"],"C:\\Users\\User\\my-app\\src\\components\\Root.js",["103"],"C:\\Users\\User\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\User\\my-app\\src\\api\\espnApi.js",["104"],"\r\nexport async function getGames(league) {\r\n    var apiPath = 'https://secure.espn.com/core/' + league + '/schedule?year=2020&xhr=1';\r\n    var response = await fetch(apiPath).then(e => e.json()).then(r => r.content.schedule);\r\n    var size = Object.keys(response).length\r\n\r\n    var games = [];\r\n    for (let index = 0; index < size; index++) {\r\n        games.push(...response[Object.keys(response)[index]].games);\r\n    }\r\n\r\n\r\n\r\n    return Promise.all(games.map(g => {\r\n        var gameOrMatch = league === 'soccer' ? 'match' : 'game';\r\n        var id = g.id\r\n        return fetch('https://secure.espn.com/core/' + league + '/' + gameOrMatch + '?gameid=' + id + '&xhr=1&v=' + Date.now()).then(e => e.json()).then(f => f.gamepackageJSON);\r\n    })).then(r => {\r\n        var dto = [];\r\n        r.map(g => {\r\n            if ((g.hasOdds && g.odds.findIndex(e => e.details && e.overUnder) >= 0) || league !== 'soccer') {\r\n                var game = {\r\n                    competitors: g.header.competitions[0].competitors,\r\n                    odds: g.hasOdds ? g.odds[g.odds.findIndex(e => e.details && e.overUnder)] : g.pickcenter[g.pickcenter.findIndex(e => e.details && e.overUnder)],\r\n                    date: g.header.competitions[0].date,\r\n                    status: g.header.competitions[0].status,\r\n                    id: g.header.id\r\n                };\r\n                dto.push(game);\r\n            }\r\n\r\n        })\r\n\r\n\r\n        return dto\r\n    })\r\n}\r\n\r\n\r\n","C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",["105"],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",[],"C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",["106","107"],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["108"],"import React, { useEffect, useState } from 'react';\r\nimport '../App.css';\r\nimport { loadGames } from \"../redux/actions/gameActions\";\r\nimport { placeWager, loadUpdatedWagers } from \"../redux/actions/userActions\"\r\nimport { connect } from \"react-redux\";\r\nimport Matchup from './Matchup'\r\nimport { Card, Spinner } from 'reactstrap';\r\nimport {\r\n    useParams\r\n} from \"react-router-dom\";\r\n\r\n\r\n\r\nfunction Games({ loadGames, placeWager, loadUpdatedWagers, user, games }) {\r\n    var { sport, week } = useParams();\r\n\r\n    useEffect(() => {\r\n        loadGames(sport, week);\r\n        loadUpdatedWagers().then(() => setDoneLoading(true))\r\n\r\n        const interval = setInterval(() => {\r\n            loadGames(sport, week)\r\n        }, 10000)\r\n\r\n        return () => clearInterval(interval)\r\n\r\n    }, [loadGames, sport, week]);\r\n\r\n    const [doneLoading, setDoneLoading] = useState(false);\r\n\r\n\r\n    return (\r\n        doneLoading ?\r\n            <div className=\"App\">\r\n                {games ? games.sort((a, b) => a.date > b.date ? 1 : -1)\r\n                    .map(\r\n                        (item, index) => {\r\n                            if (item.status.type.name !== 'STATUS_CANCELED'\r\n                                && item.status.type.name !== 'STATUS_POSTPONED'\r\n                            ) {\r\n                                return <Card key={index} style={{ margin: 20 }}><Matchup done={false} sport={sport} game={item} wagers={mapGamesToWagers(item, user.user.wagers)} placeWager={(e) => placeWager(e)} /></Card>\r\n                            }\r\n                            else {\r\n                                return []\r\n                            }\r\n\r\n                        }\r\n                    ) : []}\r\n            </div>\r\n            : <div className=\"App\">\r\n                <Spinner style={{ marginTop: '30px' }} type=\"grow\" color=\"dark\" />\r\n            </div>\r\n\r\n    )\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadGames,\r\n    placeWager,\r\n    loadUpdatedWagers\r\n};\r\n\r\nfunction mapGamesToWagers(game, wagers) {\r\n    var newWagers = Object.assign({}, game);\r\n    if (wagers) {\r\n        newWagers = wagers.filter(e => e.game_id === game.id);\r\n        return newWagers;\r\n    }\r\n    else {\r\n        return wagers;\r\n    }\r\n}\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n\r\n        games: state.games,\r\n        user: state.user\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",[],{"ruleId":"109","replacedBy":"110"},{"ruleId":"111"