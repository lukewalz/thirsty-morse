essages":"97","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"98","messages":"99","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"100","usedDeprecatedRules":"52"},{"filePath":"101","messages":"102","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"103","usedDeprecatedRules":"104"},"C:\\Users\\User\\my-app\\src\\index.js",[],["105","106"],"C:\\Users\\User\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",["107"],"import * as types from \"../actions/actionTypes\";\r\nimport produce from \"immer\"\r\n\r\n\r\nconst INITIAL_STATE = []\r\n\r\n\r\nexport const games = produce((draft, action) => {\r\n    switch (action.type) {\r\n        case types.GET_GAMES_SUCCESS: {\r\n            return action.payload\r\n        }\r\n    }\r\n}, INITIAL_STATE);","C:\\Users\\User\\my-app\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\User\\my-app\\src\\api\\espnApi.js",[],"C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",["108"],"import * as types from '../actions/actionTypes';\r\nimport Cookies from 'universal-cookie';\r\nimport produce from \"immer\"\r\n\r\nconst cookies = new Cookies();\r\n\r\n\r\nfunction isAuth() {\r\n    var auth = cookies.get('userSession') && !!localStorage.getItem(\"user\");\r\n    return auth;\r\n}\r\nconst INITIAL_STATE = {\r\n    isAuthUser: isAuth(),\r\n    user: JSON.parse(localStorage.getItem(\"user\")) || {},\r\n    isLoading: false,\r\n    error: null,\r\n    wagers: []\r\n};\r\n\r\n\r\nexport const user = produce((draft, action) => {\r\n    switch (action.type) {\r\n        case types.LOGIN_SUCCESS: {\r\n            localStorage.setItem(\"user\", JSON.stringify(action.payload));\r\n            draft.user = action.payload;\r\n            draft.isAuthUser = isAuth();\r\n            break;\r\n        }\r\n        case types.ADD_USER_SUCCESS: {\r\n            localStorage.setItem(\"user\", JSON.stringify(action.payload));\r\n            draft.user = action.payload;\r\n            draft.isAuthUser = isAuth();\r\n            break;\r\n        }\r\n        case types.LOGOUT_SUCCESS: {\r\n            draft.user = {};\r\n            draft.isAuthUser = isAuth();\r\n            break\r\n        }\r\n        case types.ADD_WAGER_SUCCESS: {\r\n            draft.wagers.push(action.payload);\r\n            break;\r\n        }\r\n        case types.GET_WAGERS_SUCCESS: {\r\n            draft.wagers = action.payload;\r\n            break;\r\n        }\r\n    }\r\n}, INITIAL_STATE);","C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",["109"],"import { Container } from 'reactstrap'\r\nimport { connect } from \"react-redux\";\r\nimport Table from '@material-ui/core/Table';\r\nimport TableBody from '@material-ui/core/TableBody';\r\nimport TableCell from '@material-ui/core/TableCell';\r\nimport TableContainer from '@material-ui/core/TableContainer';\r\nimport TableHead from '@material-ui/core/TableHead';\r\nimport TableRow from '@material-ui/core/TableRow';\r\nimport Paper from '@material-ui/core/Paper';\r\nimport { loadUpdatedWagers } from \"../redux/actions/userActions\"\r\nimport { loadGames } from \"../redux/actions/gameActions\"\r\nimport React, { useEffect } from 'react';\r\n\r\n\r\n\r\nfunction MyAccount({ loadUpdatedWagers, user }) {\r\n\r\n    useEffect(() => {\r\n        loadUpdatedWagers();\r\n        const interval = setInterval(() => {\r\n            console.log('again')\r\n            loadUpdatedWagers()\r\n        }, 10000)\r\n\r\n        return () => clearInterval(interval)\r\n    }, []);\r\n\r\n    return (\r\n        <Container>\r\n            <h3>{user.username}</h3>\r\n            <TableContainer component={Paper}>\r\n                <Table aria-label=\"simple table\">\r\n                    <TableHead>\r\n                        <TableRow>\r\n                            <TableCell>Date Placed</TableCell>\r\n                            <TableCell align=\"right\">Sport</TableCell>\r\n                            <TableCell align=\"right\">Game</TableCell>\r\n                            <TableCell align=\"right\">Game Date</TableCell>\r\n                            <TableCell align=\"right\">Selection</TableCell>\r\n                            <TableCell align=\"right\">Type</TableCell>\r\n                            <TableCell align=\"right\">Amount</TableCell>\r\n                            <TableCell align=\"right\">Boost</TableCell>\r\n                            <TableCell align=\"right\">Status</TableCell>\r\n                            <TableCell align=\"right\">Outcome</TableCell>\r\n                            <TableCell align=\"right\">Result</TableCell>\r\n                        </TableRow>\r\n                    </TableHead>\r\n                    <TableBody>\r\n                        {user.wagers.length > 0 ? user.wagers.map((row) => (\r\n                            <TableRow key={row.wager_date}>\r\n                                <TableCell component=\"th\" scope=\"row\">\r\n                                    {formatDate(row.wager_date)}\r\n                                </TableCell>\r\n                                <TableCell align=\"right\">{row.sport.toUpperCase()}</TableCell>\r\n                                <TableCell align=\"right\">{row.matchup}</TableCell>\r\n                                <TableCell align=\"right\">\r\n                                    {formatDate(row.game_date)}\r\n                                </TableCell>\r\n                                <TableCell align=\"right\">{row.selection}</TableCell>\r\n                                <TableCell align=\"right\">{row.wager_type.toUpperCase()}</TableCell>\r\n                                <TableCell align=\"right\">{row.amount}</TableCell>\r\n                                <TableCell align=\"right\">{row.boost}</TableCell>\r\n                                <TableCell align=\"right\">{row.status.toUpperCase()}</TableCell>\r\n                                <TableCell style={row.outcome.toLowerCase() === 'win' ? { color: 'green' } : row.outcome.toLowerCase() === 'loss' ? { color: 'red' } : []} align=\"right\">{row.outcome.toUpperCase()}</TableCell>\r\n                                <TableCell align=\"right\">{row.result ? Math.round(row.result) : row.result}</TableCell>\r\n                            </TableRow>\r\n                        )) : []}\r\n                    </TableBody>\r\n                </Table>\r\n            </TableContainer>\r\n        </Container>\r\n    );\r\n}\r\n\r\n\r\nfunction formatDate(date) {\r\n    var d = new Date(date);\r\n    return d.toLocaleString();\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadUpdatedWagers,\r\n    loadGames\r\n};\r\n\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n        user: state.user,\r\n        games: state.games\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(MyAccount);","C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["110"],"C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",["111"],"import React from 'react';\r\nimport { Card, Button } from 'reactstrap'\r\nimport Chip from '@material-ui/core/Chip';\r\n\r\nexport const OverUnderWidget = (props) => {\r\n    return (\r\n        <Card style={{ display: 'flex', justifyContent: 'center', height: '100%' }}>\r\n\r\n            {props.wager ? props.wager.map((e, i) => e.wager_type === 'ou' ?\r\n                e.status === 'final' ?\r\n                    e.selection.split('@')[0] === 'o' ?\r\n                        <div key={i}><Chip label={e.outcome} style={{ backgroundColor: '#8bc34a' }} onClick={g => { g.stopPropagation(); props.handleWagerClick(e) }} key={i} /></div> :\r\n                        <div key={i}><Chip label={e.outcome} style={{ backgroundColor: '#8bc34a' }} onClick={g => { g.stopPropagation(); props.handleWagerClick(e) }} key={i} /></div>\r\n                    :\r\n                    e.selection.split('@')[0] === 'o' ?\r\n                        <div key={i}><Chip label={e.selection} style={{ backgroundColor: '#8bc34a' }} onClick={g => { g.stopPropagation(); props.handleWagerClick(e) }} key={i} /></div> :\r\n                        <div key={i}><Chip label={e.selection} style={{ backgroundColor: '#8bc34a' }} onClick={g => { g.stopPropagation(); props.handleWagerClick(e) }} key={i} /></div>\r\n                : []) : []}\r\n            <b style={{ fontSize: '20px' }}>{props.overUnder}</b>\r\n        </Card>\r\n\r\n    )\r\n}","C:\\Users\\User\\my-app\\src\\subscriptions.js",["112"],"\r\nimport axios from \"axios\";\r\n\r\nconst path = process.env.NODE_ENV === 'development' ? 'http://localhost:9000/.netlify/functions/server/notifications/register' : '/.netlify/functions/server/notifications/register'\r\n\r\nconst vapidPublicKey = 'BGuyWcyfyg50-ixydbkI2AEeFDFJvHhN-5xD4c1bGz5zWySLs1Zh8d3HZPoAxnSyWkAKn-erIqSN-5l1a6jZbTQ'\r\nconst convertedVapidKey = urlBase64ToUint8Array(vapidPublicKey)\r\n\r\nfunction urlBase64ToUint8Array(base64String) {\r\n    const padding = \"=\".repeat((4 - base64String.length % 4) % 4)\r\n    const base64 = (base64String + padding).replace(/\\-/g, \"+\").replace(/_/g, \"/\")\r\n\r\n    const rawData = window.atob(base64)\r\n    const outputArray = new Uint8Array(rawData.length)\r\n\r\n    for (let i = 0; i < rawData.length; ++i) {\r\n        outputArray[i] = rawData.charCodeAt(i)\r\n    }\r\n    return outputArray\r\n}\r\n\r\nexport default function subscribePush() {\r\n    navigator.serviceWorker.register(\"/sw.js\");\r\n    console.log('here')\r\n    navigator.serviceWorker.ready.then(registration => {\r\n        if (!registration.pushManager) {\r\n            alert(\"Push Unsupported\")\r\n            return\r\n        };\r\n        registration.pushManager\r\n            .subscribe({\r\n                userVisibleOnly: true,\r\n                applicationServerKey: convertedVapidKey\r\n            })\r\n            .then(subscription => axios.post(path, subscription))\r\n            .catch(err => console.error(\"Push subscription error: \", err))\r\n    })\r\n}",["113","114"],{"ruleId":"115","replacedBy":"116"},{"ruleId":"117","replacedBy":"118"},{"ruleId":"119","severity":1,"message":"120","line":9,"column":5,"nodeType":"121","messageId":"122","endLine":13,"endColumn":6},{"ruleId":"119","severity":1,"message":"120","line":22,"column":5,"nodeType":"121","messageId":"122","endLine":48,"endColumn":6},{"ruleId":"123","severity":1,"message":"124","line":26,"column":8,"nodeType":"125","endLine":26,"endColumn":10,"suggestions":"126"},{"ruleId":"123","severity":1,"message":"127","line":28,"column":8,"nodeType":"125","endLine":28,"endColumn":10,"suggestions":"128"},{"ruleId":"129","severity":1,"message":"130","line":2,"column":16,"nodeType":"131","messageId":"132","endLine":2,"endColumn":22},{"ruleId":"133","severity":1,"message":"134","line":11,"column":54,"nodeType":"135","messageId":"136","endLine":11,"endColumn":55,"suggestions":"137"},{"ruleId":"115","replacedBy":"138"},{"ruleId":"117","replacedBy":"139"},"no-native-reassign",["140"],"no-negated-in-lhs",["141"],"default-case","Expected