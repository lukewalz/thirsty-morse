.odds.findIndex(e => e.details && e.overUnder)] : g.pickcenter[g.pickcenter.findIndex(e => e.details && e.overUnder)],\r\n                    date: g.header.competitions[0].date,\r\n                    status: g.header.competitions[0].status,\r\n                    id: g.header.id\r\n                };\r\n                dto.push(game);\r\n            }\r\n\r\n        })\r\n\r\n\r\n        return dto\r\n    })\r\n}\r\n\r\n\r\n","C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",[],"C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],["105","106"],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["107"],"C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",[],{"ruleId":"108","replacedBy":"109"},{"ruleId":"110","replacedBy":"111"},{"ruleId":"112","severity":1,"message":"113","line":8,"column":8,"nodeType":"114","messageId":"115","endLine":8,"endColumn":17},{"ruleId":"116","severity":1,"message":"117","line":20,"column":17,"nodeType":"118","messageId":"119","endLine":20,"endColumn":19},{"ruleId":"108","replacedBy":"120"},{"ruleId":"110","replacedBy":"121"},{"ruleId":"122","severity":1,"message":"123","line":26,"column":8,"nodeType":"124","endLine":26,"endColumn":32,"suggestions":"125"},"no-native-reassign",["126"],"no-negated-in-lhs",["127"],"no-unused-vars","'AuthRoute' is defined but never used.","Identifier","unusedVar","array-callback-return","Array.prototype.map() expects a return value from arrow function.","A