y);\r\n  };\r\n\r\n  return (\r\n    <div className=\"App\">\r\n      <Pagination count={4} onChange={(e, i) => handleChange(e, i)} />\r\n      {!loading ? (\r\n        games ? (\r\n          games\r\n            .slice()\r\n            .sort((a, b) => (a.date > b.date ? 1 : -1))\r\n            .map((item) => (\r\n              <Paper elevation={10} key={item.id}>\r\n                <Matchup sport={sport} league={league} game={item} />\r\n              </Paper>\r\n            ))\r\n        ) : (\r\n          <Typography>No games listed</Typography>\r\n        )\r\n      ) : (\r\n        <div style={{ marginTop: 70 }}>\r\n          <CircularProgress size={80} />\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\nconst mapDispatchToProps = {\r\n  loadGames,\r\n  loadUpdatedWagers,\r\n};\r\n\r\nfunction mapStateToProps(state) {\r\n  return {\r\n    games: state.games,\r\n  };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\thirsty-morse\\src\\theme.js",[],"C:\\Users\\User\\thirsty-morse\\src\\pages\\Login.js",[],"C:\\Users\\User\\thirsty-morse\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\thirsty-morse\\src\\pages\\Register.js",[],"C:\\Users\\User\\thirsty-morse\\src\\pages\\MyAccount.js",["104","105"],"C:\\Users\\User\\thirsty-morse\\src\\components\\Nav.js",["106","107","108"],"C:\\Users\\User\\thirsty-morse\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\thirsty-morse\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\thirsty-morse\\src\\pages\\Matchup.js",["109","110"],"C:\\Users\\User\\thirsty-morse\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\thirsty-morse\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\thirsty-morse\\src\\components\\Widget.js",[],"C:\\Users\\User\\thirsty-morse\\src\\subscriptions.js",[],"C:\\Users\\User\\thirsty-morse\\src\\api\\espnApi.js",[],"C:\\Users\\User\\thirsty-morse\\src\\components\\OverUnderWidget.js",["111"],"import React from 'reac