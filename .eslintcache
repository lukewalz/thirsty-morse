":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"50"},"C:\\Users\\User\\my-app\\src\\index.js",[],["98","99"],"C:\\Users\\User\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",["100"],"import * as types from \"../actions/actionTypes\";\r\nimport produce from \"immer\"\r\n\r\n\r\nconst INITIAL_STATE = []\r\n\r\n\r\nexport const games = produce((draft, action) => {\r\n    switch (action.type) {\r\n        case types.GET_GAMES_SUCCESS: {\r\n            return action.payload\r\n        }\r\n    }\r\n}, INITIAL_STATE);","C:\\Users\\User\\my-app\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\User\\my-app\\src\\api\\espnApi.js",["101"],"\r\nexport async function getGames(league) {\r\n    var apiPath = 'https://secure.espn.com/core/' + league + '/schedule?year=2020&xhr=1';\r\n    var response = await fetch(apiPath).then(e => e.json()).then(r => r.content.schedule);\r\n    var size = Object.keys(response).length\r\n\r\n    var games = [];\r\n    for (let index = 0; index < size; index++) {\r\n        games.push(...response[Object.keys(response)[index]].games);\r\n    }\r\n\r\n\r\n\r\n    return Promise.all(games.map(g => {\r\n        var gameOrMatch = league === 'soccer' ? 'match' : 'game';\r\n        var id = g.id\r\n        return fetch('https://secure.espn.com/core/' + league + '/' + gameOrMatch + '?gameid=' + id + '&xhr=1&v=' + Date.now()).then(e => e.json()).then(f => f.gamepackageJSON);\r\n    })).then(r => {\r\n        var dto = [];\r\n        r.map(g => {\r\n            if (((g.odds && g.odds.findIndex(e => e.details && e.overUnder) >= 0)) || (g.pickcenter && g.pickcenter.findIndex(e => e.details && e.overUnder) >= 0)) {\r\n                var game = {\r\n                    competitors: g.header.competitions[0].competitors,\r\n                    odds: league === 'soccer' ? g.odds[g.odds.findIndex(e => e.details && e.overUnder)] : g.pickcenter[g.pickcenter.findIndex(e => e.details && e.overUnder)],\r\n                    date: g.header.competitions[0].date,\r\n                    status: g.header.competitions[0].status,\r\n                    id: g.header.id,\r\n                    lastPlay: g.commentary ? g.commentary[g.commentary.length - 1]?.text : g.plays ? g.plays[g.plays.length - 1]?.text : '',\r\n                    boxScore: g.boxscore.teams\r\n                };\r\n                dto.push(game);\r\n            }\r\n\r\n        })\r\n\r\n        return dto\r\n    })\r\n}\r\n\r\n\r\n","C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",["102","103"],"import React, { useEffect } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { AppBar, Toolbar, Button, Typography, Badge } from \"@material-ui/core\";\r\nimport { connect } from \"react-redux\";\r\nimport { logout } from \"../redux/actions/userActions\";\r\n\r\n\r\nfunction NavBar({ logout, user }) {\r\n\r\n    function getBalance() {\r\n        if (user.user.wagers) {\r\n            var balance = 0;\r\n            user.user.wagers.filter(e => e.status === 'final').map(w => {\r\n                balance += parseInt(w.result);\r\n            });\r\n            return '$' + balance;\r\n        }\r\n        else {\r\n            return '$0'\r\n        }\r\n    }\r\n\r\n    return (\r\n        <AppBar position=\"static\" style={{ display: \"flex\", backgroundColor: '#78b13f' }}>\r\n            <Toolbar>\r\n                <Typography variant=\"h6\">LSPN</Typography>\r\n                <div style={{ marginLeft: \"auto\" }}>\r\n                    {user.isAuthUser ? (\r\n                        <div>\r\n                            <Badge>{getBalance(user)}</Badge>\r\n                            <Link to=\"/home\">\r\n                                <Button>Dashboard</Button>\r\n                            </Link>\r\n                            <Link to=\"/my-account\">\r\n                                <Button>My Account</Button>\r\n                            </Link>\r\n                            <Button onClick={logout}>\r\n                                Logout\r\n                            </Button>\r\n                        </div>\r\n                    ) : (\r\n                            <div>\r\n                                <Link to=\"/login\">\r\n                                    <Button>Login</Button>\r\n                                </Link>\r\n                                <Link to=\"/register\">\r\n                                    <Button>Register</Button>\r\n                                </Link>\r\n                            </div>\r\n                        )}\r\n                </div>\r\n            </Toolbar>\r\n        </AppBar>\r\n    );\r\n}\r\n\r\n\r\nfunction mapStateToProps(state) {\r\n    return {\r\n        user: state.user\r\n    };\r\n}\r\n\r\nconst mapDispatchToProps = {\r\n    logout\r\n};\r\n\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(NavBar);\r\n","C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",["104","105"],"C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",["106"],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["107","108","109"],"C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",["110"],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",[],{"ruleId":"111","replacedBy":"1