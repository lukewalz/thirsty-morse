env.NODE_ENV === 'development' ? 'http://localhost:9000/.netlify/functions/server/users' : '/.netlify/functions/server/users'\r\n    return fetch(path + '?username=' + username,\r\n        {\r\n            headers: {\r\n                'x-auth-token': token\r\n            }\r\n        }).then(response => response.json()).then(t => t)\r\n}\r\n\r\nexport async function register(username, password, firstName, lastName) {\r\n    const path = process.env.NODE_ENV === 'development' ? 'http://localhost:9000/.netlify/functions/server/users' : '/.netlify/functions/server/users'\r\n    var userData = await fetch(path, {\r\n        method: 'POST', headers: {\r\n            'Content-Type': 'application/json'\r\n        }, body: JSON.stringify({ username, password, firstName, lastName })\r\n    })\r\n\r\n        .then(response => {\r\n            if (response.ok) {\r\n                return response.json();\r\n            } else if (response.status == 400) {\r\n                console.log(response)\r\n                throw new Error('Username already exists');\r\n            } else {\r\n                throw new Error('User failed to add');\r\n            }\r\n        })\r\n        .catch(er => { throw Error(er) })\r\n        .then(user => {\r\n            const cookies = new Cookies();\r\n            cookies.set('userSession', user.token);\r\n\r\n            var u = _.pick(user, ['username', 'firstName', 'lastName'])\r\n            console.log(u);\r\n            return u;\r\n        })\r\n    console.log(userData)\r\n    return userData;\r\n}","C:\\Users\\User\\my-app\\src\\components\\Nav.js",["108"],"import React, { Component } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { AppBar, Toolbar, Button, Typography } from \"@material-ui/core\";\r\nimport { connect } from \"react-redux\";\r\n\r\nimport { logout } from \"../redux/actions/userActions\";\r\n\r\nfunction NavBar({ user, logout, ...props }) {\r\n    return (\r\n        <AppBar position=\"static\" style={{ display: \"flex\", backgroundColor: '#78b13f' }}>\r\n            <Toolbar>\r\n                <Typography variant=\"h6\">LSPN</Typography>\r\n                <div style={{ marginLeft: \"auto\" }}>\r\n                    {user.isAuthUser ? (\r\n                        <>\r\n                            <Link to=\"/home\">\r\n                                <Button>Dashboard</Button>\r\n                            </Link>\r\n                            <Link to=\"/my-account\">\r\n                                <Button>My Account</Button>\r\n                            </Link>\r\n                            <Button onClick={logout}>\r\n                                Logout\r\n                </Button>\r\n                        </>\r\n                    ) : (\r\n                            <>\r\n                                <Link to=\"/login\">\r\n                                    <Button>Login</Button>\r\n                                </Link>\r\n                                <Link to=\"/register\">\r\n                                    <Button>Register</Button>\r\n                                </Link>\r\n                            </>\r\n                        )}\r\n                </div>\r\n            </Toolbar>\r\n        </AppBar>\r\n    );\r\n}\r\n\r\n\r\nexport default connect(({ user }) => ({ user }), { logout })(\r\n    NavBar\r\n);","C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",["109"],"import { API_SUCCESS, API_ERROR, SET_LOADER, LOGOUT } from '../actions/actionTypes';\r\n\r\nexport default (\r\n    state = {\r\n        isAuthUser: !!localStorage.getItem(\"user\"),\r\n        user: JSON.parse(localStorage.getItem(\"user\")) || {},\r\n        isLoading: false,\r\n        error: null\r\n    },\r\n    action\r\n) => {\r\n    switch (action.type) {\r\n        case API_SUCCESS:\r\n            localStorage.setItem(\"user\", JSON.stringify(action.payload.user));\r\n            return { ...state, isAuthUser: true, user: action.payload.user, error: null };\r\n        case API_ERROR:\r\n            return { ...state, isAuthUser: false, user: {}, error: action.payload.error };\r\n        case SET_LOADER:\r\n            return { ...state, isLoading: action.payload };\r\n        case LOGOUT:\r\n            return { ...state, isAuthUser: false, user: {} };\r\n        default:\r\n            return state;\r\n    }\r\n};","C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",["110"],"import { types } from \"joi\";\r\nimport React from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Redirect, Route } from \"react-router\";\r\n\r\nconst AuthRoute = props => {\r\n    const { user, type } = props;\r\n    if (type === \"guest\" && user.isAuthUser) return <Redirect to=\"/home\" />;\r\n    else if (type === \"private\" && !user.isAuthUser) return <Redirect to=\"/\" />;\r\n\r\n    return <Route {...props} />;\r\n};\r\n\r\nconst mapStateToProps = ({ user }) => ({\r\n    user\r\n});\r\n\r\nexport default connect(mapStateToProps)(AuthRoute);","C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],["111","112"],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",["113"],"import React, { useState, useEffect } from \"react\";\r\nimport { TextField, Typography, Button } from \"@material-ui/core\";\r\nimport { connect } from \"react-redux\";\r\nimport { login } from \"../redux/actions/userActions\";\r\nimport MuiAlert from \"@material-ui/lab/Alert\";\r\nimport { makeStyles } from '@material-ui/core/styles';\r\n\r\n\r\nfunction Alert(props) {\r\n    return <MuiAlert elevation={6} variant=\"filled\" {...props} />;\r\n}\r\n\r\nexport default connect(({ isLoading, user }) => ({ isLoading, user }), { login })(props => {\r\n    const [email, setEmail] = useState(\"\");\r\n    const [password, setPassword] = useState(\"\");\r\n    const [errors, setErrors] = useState(\"\");\r\n\r\n\r\n    useEffect(() => {\r\n        setErrors(props.user.error?.message)\r\n    }, [props.user.error])\r\n\r\n    const submitForm = () => {\r\n        if (email === \"\" || password === \"\") {\r\n            setErrors(\"Fields are required\");\r\n            return;\r\n        }\r\n        props.login(email, password);\r\n    };\r\n\r\n\r\n    return (\r\n        <form className='container'>\r\n            <Typography variant=\"h5\" style={{ marginBottom: 8 }}>\r\n                Login\r\n      </Typography>\r\n            <TextField\r\n                label=\"Email\"\r\n                variant=\"outlined\"\r\n                className=\"form-input\"\r\n                value={email}\r\n                onChange={e => setEmail(e.target.value)}\r\n                required={true}\r\n\r\n            />\r\n            <TextField\r\n                label=\"Password\"\r\n                variant=\"outlined\"\r\n                className=\"form-input\"\r\n                type=\"password\"\r\n                value={password}\r\n                onChange={e => setPassword(e.target.value)}\r\n                required={true}\r\n\r\n            />\r\n            <Button\r\n                variant=\"contained\"\r\n                color=\"primary\"\r\n                className=\"form-input\"\r\n                size=\"large\"\r\n                onClick={submitForm}\r\n            >\r\n                Login\r\n      </Button>\r\n\r\n            {(props.errors || errors) && (\r\n                <Alert severity=\"error\" onClick={() => setErrors(null)}>\r\n                    {props.errors || errors}\r\n                </Alert>\r\n            )}\r\n        </form>\r\n    );\r\n});","C:\\Users\\User\\my-app\\src\\pages\\Games.js",["114","115","116"],"import React, { useEffect, useState } from 'react';\r\nimport '../App.css';\r\nimport { loadGames } from \"../redux/actions/gameActions\";\r\nimport { connect } from \"react-redux\";\r\nimport Matchup from './Matchup'\r\nimport { Container, Card, Button, Spinner } from 'reactstrap';\r\nimport {\r\n    useParams\r\n} from \"react-router-dom\";\r\n\r\n\r\nfunction Games({ loadGames, games }) {\r\n    var { sport, week } = useParams();\r\n\r\n    useEffect(() => {\r\n        loadGames(sport, week).then(() => setDoneLoading(true));\r\n    }, [loadGames]);\r\n\r\n    const [doneLoading, setDoneLoading] = useState(false);\r\n    const [myPicks, setMyPicks] = useState(false);\r\n\r\n\r\n    return (\r\n        doneLoading ?\r\n            <div className=\"App\">\r\n                {/* <Button onClick={() => setMyPicks(!myPicks)}>{myPicks ? 'Show All Matchups' : 'Show Only My Picks'}</Button> */}\r\n                {games?.map(\r\n                    (item, index) => {\r\n                        return <Card key={index} style={{ margin: 20 }}><Matchup game={item} myPicks={myPicks} /></Card>\r\n\r\n                    }\r\n                )}\r\n            </div>\r\n            : <div className=\"App\">\r\n                <Spinner type=\"grow\" color=\"dark\" />\r\n            </div>\r\n\r\n    )\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadGames\r\n};\r\n\r\nfunction mapStateToProps(state) {\r\n    console.log(state);\r\n    return {\r\n        games: state.games,\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",["117","118"],"import React, { useState, useEffect } from \"react\";\r\nimport { TextField, Typography, Button } from \"@material-ui/core\";\r\nimport { connect } from \"react-redux\";\r\nimport { register } from \"../redux/actions/userActions\";\r\nimport MuiAlert from \"@material-ui/lab/Alert\";\r\n\r\nfunction Alert(props) {\r\n    return <MuiAlert elevation={6} variant=\"filled\" {...props} />;\r\n}\r\n\r\nexport default connect(({ isLoading, user }) => ({ isLoading, user }), { register })(props => {\r\n    const [email, setEmail] = useState(\"\");\r\n    const [firstName, setFirstName] = useState(\"\");\r\n    const [lastName, setLastName] = useState(\"\");\r\n    const [password, setPassword] = useState(\"\");\r\n    const [errors, setErrors] = useState(\"\");\r\n\r\n\r\n    useEffect(() => {\r\n        setErrors(props.user.error?.message)\r\n    }, [props.user.error])\r\n\r\n    const submitForm = () => {\r\n        if (email === \"\" || password === \"\" || firstName == \"\" || lastName == \"\") {\r\n            setErrors(\"Fields are required\");\r\n            return;\r\n        }\r\n        props.register(email, password, firstName, lastName);\r\n    };\r\n\r\n    return (\r\n        <form className='container'>\r\n            <Typography variant=\"h5\" style={{ marginBottom: 8 }}>\r\n                Register\r\n      </Typography>\r\n            <TextField\r\n                label=\"Email\"\r\n                variant=\"outlined\"\r\n                fullWidth\r\n                className=\"form-input\"\r\n                value={email}\r\n                onChange={e => setEmail(e.target.value)}\r\n            />\r\n            <TextField\r\n                label=\"First Name\"\r\n                variant=\"outlined\"\r\n                fullWidth\r\n                className=\"form-input\"\r\n                value={firstName}\r\n                onChange={e => setFirstName(e.target.value)}\r\n            />\r\n            <TextField\r\n                label=\"Last Name\"\r\n                variant=\"outlined\"\r\n                fullWidth\r\n                className=\"form-input\"\r\n                value={lastName}\r\n                onChange={e => setLastName(e.target.value)}\r\n            />\r\n            <TextField\r\n                label=\"Password\"\r\n                variant=\"outlined\"\r\n                fullWidth\r\n                className=\"form-input\"\r\n                type=\"password\"\r\n                value={password}\r\n                onChange={e => setPassword(e.target.va