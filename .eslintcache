\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",["93"],"import React, { Component } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { AppBar, Toolbar, Button, Typography } from \"@material-ui/core\";\r\nimport { connect } from \"react-redux\";\r\n\r\nimport { logout } from \"../redux/actions/userActions\";\r\n\r\nfunction NavBar({ user, logout, ...props }) {\r\n    return (\r\n        <AppBar position=\"static\" style={{ display: \"flex\" }}>\r\n            <Toolbar>\r\n                <Typography variant=\"h6\">LSPN</Typography>\r\n                <div style={{ marginLeft: \"auto\" }}>\r\n                    {user.isAuthUser ? (\r\n                        <>\r\n                            <Link to=\"/home\">\r\n                                <Button color=\"inherit\">Home</Button>\r\n                            </Link>\r\n                            <Link to=\"/my-account\">\r\n                                <Button color=\"inherit\">My Account</Button>\r\n                            </Link>\r\n                            <Button color=\"inherit\" onClick={logout}>\r\n                                Logout\r\n                </Button>\r\n                        </>\r\n                    ) : (\r\n                            <Link to=\"/login\">\r\n                                <Button color=\"inherit\">Login</Button>\r\n                            </Link>\r\n                        )}\r\n                </div>\r\n            </Toolbar>\r\n        </AppBar>\r\n    );\r\n}\r\n\r\n\r\nexport default connect(({ user }) => ({ user }), { logout })(\r\n    NavBar\r\n);","C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",["94"],"import { API_SUCCESS, API_ERROR, SET_LOADER, LOGOUT } from '../actions/actionTypes';\r\n\r\nexport default (\r\n    state = {\r\n        isAuthUser: !!localStorage.getItem(\"user\"),\r\n        user: JSON.parse(localStorage.getItem(\"user\")) || {},\r\n        isLoading: false,\r\n        error: null\r\n    },\r\n    action\r\n) => {\r\n    switch (action.type) {\r\n        case API_SUCCESS:\r\n            localStorage.setItem(\"user\", JSON.stringify(action.payload.user));\r\n            return { ...state, isAuthUser: true, user: action.payload.user, error: null };\r\n        case API_ERROR:\r\n            return { ...state, isAuthUser: false, user: {}, error: action.payload.error };\r\n        case SET_LOADER:\r\n            return { ...state, isLoading: action.payload };\r\n        case LOGOUT:\r\n            return { ...state, isAuthUser: false, user: {} };\r\n        default:\r\n            return state;\r\n    }\r\n};","C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",["95"],"import { types } from \"joi\";\r\nimport React from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Redirect, Route } from \"react-router\";\r\n\r\nconst AuthRoute = props => {\r\n    const { user, type } = props;\r\n    if (type === \"guest\" && user.isAuthUser) return <Redirect to=\"/home\" />;\r\n    else if (type === \"private\" && !user.isAuthUser) return <Redirect to=\"/\" />;\r\n\r\n    return <Route {...props} />;\r\n};\r\n\r\nconst mapStateToProps = ({ user }) => ({\r\n    user\r\n});\r\n\r\nexport default connect(mapStateToProps)(AuthRoute);","C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["96"],"import React, { useEffect, useState } from 'react';\r\nimport '../App.css';\r\nimport { loadGames } from \"../redux/actions/gameActions\";\r\nimport { connect } from \"react-redux\";\r\nimport Matchup from './Matchup'\r\nimport { Container, Card, Button, Spinner } from 'reactstrap';\r\nimport {\r\n    useParams\r\n} from \"react-router-dom\";\r\n\r\n\r\nfunction Games({ loadGames, games }) {\r\n    var { sport, week } = useParams();\r\n\r\n    useEffect(() => {\r\n        loadGames(sport, week).then(() => setDoneLoading(true));\r\n    }, [loadGames]);\r\n\r\n    const [doneLoading, setDoneLoading] = useState(false);\r\n    const [myPicks, setMyPicks] = useState(false);\r\n\r\n\r\n    return (\r\n        doneLoading ?\r\n            <Container>\r\n                <Button onClick={() => setMyPicks(!myPicks)}>{myPicks ? 'Show All Matchups' : 'Show Only My Picks'}</Button>\r\n                {games?.map(\r\n                    (item, index) => {\r\n                        return <Card key={index} style={{ margin: 20 }}><Matchup game={item} myPicks={myPicks} /></Card>\r\n\r\n                    }\r\n                )}\r\n            </Container>\r\n            : <Container>      <Spinner type=\"grow\" color=\"dark\" />\r\n            </Container>\r\n\r\n    )\r\n}\r\n\r\n\r\nconst mapDispatchToProps = {\r\n    loadGames\r\n};\r\n\r\nfunction mapStateToProps(state) {\r\n    console.log(state);\r\n    return {\r\n        games: state.games,\r\n    };\r\n}\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Games);\r\n","C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],{"ruleId":"97","replacedBy":"98"},{"ruleId":"99","replacedBy":"100"},{"ruleId":"101","severity":1,"message":"102","line":8,"column":8,"nodeType":"103","messageId":"104","endLine":8,"endColumn":17},{"ruleId":"97","replacedBy":"105"},{"ruleId":"99","replacedBy":"106"},{"ruleId":"101","severity":1,"message":"107","line":1,"column":17,"nodeType":"103","messageId":"104","endLine":1,"endColumn":26},{"ruleId":"108","severity":1,"message":"109","line":3,"column":1,"nodeType":"110","endLine":25,"endColumn":3},{"ruleId":"101","severity":1,"message":"111","line":1,"column":10,"nodeType":"103","messageId":"104","endLine":1,"endColumn":15},{"ruleId":"112","severity":1,"message":"113","line":17,"column":8,"nodeType":"114","endLine":17,"endColumn":19,"suggestions":"115"},"no-native-reassign",["116"],"no-negated-i