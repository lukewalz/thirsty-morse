ser\\my-app\\src\\redux\\configureStore.js",[],"C:\\Users\\User\\my-app\\src\\App.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\index.js",[],"C:\\Users\\User\\my-app\\src\\components\\Widget.js",[],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\games.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\gameActions.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\User\\my-app\\src\\api\\espnApi.js",["98"],"\r\nexport async function getGames(league) {\r\n    var apiPath = 'https://secure.espn.com/core/' + league + '/schedule?year=2020&xhr=1';\r\n    var response = await fetch(apiPath).then(e => e.json()).then(r => r.content.schedule);\r\n    var size = Object.keys(response).length\r\n\r\n    var games = [];\r\n    for (let index = 0; index < size; index++) {\r\n        games.push(...response[Object.keys(response)[index]].games);\r\n    }\r\n\r\n\r\n\r\n    return Promise.all(games.map(g => {\r\n        var gameOrMatch = league === 'soccer' ? 'match' : 'game';\r\n        var id = g.id\r\n        return fetch('https://secure.espn.com/core/' + league + '/' + gameOrMatch + '?gameid=' + id + '&xhr=1&v=' + Date.now()).then(e => e.json()).then(f => f.gamepackageJSON);\r\n    })).then(r => {\r\n        var dto = [];\r\n        r.map(g => {\r\n            if (((g.odds && g.odds.findIndex(e => e.details && e.overUnder) >= 0)) || (g.pickcenter && g.pickcenter.findIndex(e => e.details && e.overUnder) >= 0)) {\r\n                var game = {\r\n                    competitors: g.header.competitions[0].competitors,\r\n                    odds: league === 'soccer' ? g.odds[g.odds.findIndex(e => e.details && e.overUnder)] : g.pickcenter[g.pickcenter.findIndex(e => e.details && e.overUnder)],\r\n                    date: g.header.competitions[0].date,\r\n                    status: g.header.competitions[0].status,\r\n                    id: g.header.id,\r\n                    lastPlay: g.commentary ? g.commentary[g.commentary.length - 1]?.text : g.plays ? g.plays[g.plays.length - 1]?.text : '',\r\n                    boxScore: g.boxscore.teams\r\n                };\r\n                dto.push(game);\r\n            }\r\n\r\n        })\r\n\r\n        return dto\r\n    })\r\n}\r\n\r\n\r\n","C:\\Users\\User\\my-app\\src\\api\\lspnApi.js",[],"C:\\Users\\User\\my-app\\src\\components\\Nav.js",["99","100"],"C:\\Users\\User\\my-app\\src\\redux\\reducers\\user.js",[],"C:\\Users\\User\\my-app\\src\\components\\AuthRoute.js",[],"C:\\Users\\User\\my-app\\src\\redux\\actions\\userActions.js",[],"C:\\Users\\User\\my-app\\src\\pages\\MyAccount.js",[],"C:\\Users\\User\\my-app\\src\\pages\\HomePage.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Login.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Games.js",["101","102"],"C:\\Users\\User\\my-app\\src\\pages\\Matchup.js",[],"C:\\Users\\User\\my-app\\src\\pages\\Register.js",[],"C:\\Users\\User\\my-app\\src\\theme.js",[],"C:\\Users\\User\\my-app\\src\\components\\WagerModal.js",[],"C:\\Users\\User\\my-app\\src\\components\\OverUnderWidget.js",[],{"ruleId":"103","replacedBy":"104"},{"ruleId":"105","replacedBy":"106"},{"ruleId":"107","severity":1,"message":"108","line":20,"column":17,"nodeType":"109","messageId":"110","endLine":20,"endColumn":19},{"ruleId":"111","severity":1,"message":"112","line":1,"column":17,"nodeType":"113","messageId":"114","endLine":1,"endColumn":26},{"ruleId":"107","severity":1,"message":"108","line":13,"column":70,"nodeType":"109","messageId":"110","endLine":13,"endColumn":72},{"ruleId":"111","severity":1,"message":"115","line":1,"column":28,"nodeType":"113","messageId":"114","endLine":1,"endColumn":36},{"ruleId":"116","severity":1,"message":"117","line":26,"column":8,"nodeType":"118","endLine":26,"endColumn":10,"suggestions":"119"},"no-native-reassign",["120"],"no-negated-in-lhs",["121"],"array-callback-return","Array.prototype.map() expects a return value from arrow function.","ArrowFunctionExpression","expectedInside","no-unused-vars","'useEffect'